    ?title "The NUBASE2020 evaluation of nuclear physics properties"
    ?journal "Chinese Physics C"
    ?year 2021
    ?volume 45
    ?pages "030001"
    ?doi "10.1088/1674-1137/abddae"
    ?url "https://www-nds.iaea.org/amdc/ame2020/NUBASE2020.pdf"
