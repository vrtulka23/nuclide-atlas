# The database is composed from independently maintainable DIPL sources.
$source constants = "constants.dip"
$source uranium = "elements/U.dip"
$source lead = "elements/Pb.dip"
$source U238 = "isotopes/U238.dip"
$source U239 = "isotopes/U239.dip"
$source Np239 = "isotopes/Np239.dip"
$source Th234 = "isotopes/Th234.dip"
$source Pa234m = "isotopes/Pa234m.dip"
$source U234 = "isotopes/U234.dip"
$source Th230 = "isotopes/Th230.dip"
$source Ra226 = "isotopes/Ra226.dip"
$source Rn222 = "isotopes/Rn222.dip"
$source Po218 = "isotopes/Po218.dip"
$source Pb214 = "isotopes/Pb214.dip"
$source Bi214 = "isotopes/Bi214.dip"
$source Po214 = "isotopes/Po214.dip"
$source Pb210 = "isotopes/Pb210.dip"
$source Bi210 = "isotopes/Bi210.dip"
$source Po210 = "isotopes/Po210.dip"
$source Pb206 = "isotopes/Pb206.dip"
$source Pu239 = "isotopes/Pu239.dip"
$source U235 = "isotopes/U235.dip"
$source Pb207 = "isotopes/Pb207.dip"

# Contract applied to every isotope in the resolved catalogue.  The small source
# files remain independently maintainable, while this registry is the quality
# gate for the exact fields that the solver consumes.
$schema isotope_record
  id str
    !format "[A-Z][a-z]?[0-9]+m?"
  label str
    !format ".{3,80}"
  atomic_mass float g/mol
    !condition ({.} > 0 g/mol)
  stable bool
  half_life float s
    !condition ({.} >= 0 s)
  decay
    daughter str
      !format "(none|[A-Z][a-z]?[0-9]+m?)"
    branching float
      !condition ({.} >= 0 && {.} <= 1)
    mode str
      !options ["alpha", "beta-", "stable"]
    energy float MeV
      !condition ({.} >= 0 MeV)

# Shared contract for every calculation request. Scenarios only assign values;
# their types, units, constraints, and allowed grid choices live here.
$schema nuclear_simulation
  title str
    !format ".{3,160}"
  sample
    isotope str
      !format "[A-Z][a-z]?[0-9]+m?"
    mass float g
      !condition ({.} > 0 g)
  duration float s
    !condition ({.} > 0 s)
  points int
    !condition ({.} >= 2 && {.} <= 1000000)
  time_grid str
    !options ["linear", "logarithmic"]
  minimum_time float s
    !condition ({.} > 0 s && {.} < {?simulation.duration})
  output
    csv str
      !format "[A-Za-z0-9_./-]+[.]csv"
    include_activity bool
    include_q_power bool

# One-group activation model.  A capture reaction is applied during irradiation;
# natural decay remains active during both irradiation and cooldown.  The
# simulation intentionally keeps reaction spectra out of scope: the supplied
# flux and cross section must already be spectrum-averaged and self-consistent.
$schema activation_simulation
  title str
    !format ".{3,160}"
  sample
    isotope str
      !format "[A-Z][a-z]?[0-9]+m?"
    mass float g
      !condition ({.} > 0 g)
  irradiation
    duration float s
      !condition ({.} > 0 s)
    points int
      !condition ({.} >= 2 && {.} <= 100000)
    neutron_flux float 1/(cm2*s)
      !condition ({.} > 0 1/(cm2*s))
    capture
      target str
        !format "[A-Z][a-z]?[0-9]+m?"
      product str
        !format "[A-Z][a-z]?[0-9]+m?"
      cross_section float cm2
        !condition ({.} > 0 cm2)
  cooldown
    duration float s
      !condition ({.} >= 0 s)
    points int
      !condition ({.} >= 2 && {.} <= 100000)
  output
    csv str
      !format "[A-Za-z0-9_./-]+[.]csv"
    include_activity bool
    include_q_power bool

nuclear
  constants {constants?constants.}
  elements
    U {uranium?element.}
    Pb {lead?element.}
  # A keyed collection applies isotope_record to every item.  Each source is
  # imported as a whole record, preserving its unit declarations and metadata.
  isotopes map : isotope_record
  isotopes[U238]
    {U238?isotope.}
  isotopes[U239]
    {U239?isotope.}
  isotopes[Np239]
    {Np239?isotope.}
  isotopes[Th234]
    {Th234?isotope.}
  isotopes[Pa234m]
    {Pa234m?isotope.}
  isotopes[U234]
    {U234?isotope.}
  isotopes[Th230]
    {Th230?isotope.}
  isotopes[Ra226]
    {Ra226?isotope.}
  isotopes[Rn222]
    {Rn222?isotope.}
  isotopes[Po218]
    {Po218?isotope.}
  isotopes[Pb214]
    {Pb214?isotope.}
  isotopes[Bi214]
    {Bi214?isotope.}
  isotopes[Po214]
    {Po214?isotope.}
  isotopes[Pb210]
    {Pb210?isotope.}
  isotopes[Bi210]
    {Bi210?isotope.}
  isotopes[Po210]
    {Po210?isotope.}
  isotopes[Pb206]
    {Pb206?isotope.}
  isotopes[Pu239]
    {Pu239?isotope.}
  isotopes[U235]
    {U235?isotope.}
  isotopes[Pb207]
    {Pb207?isotope.}
