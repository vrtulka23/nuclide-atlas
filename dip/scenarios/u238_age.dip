# A deliberately small, human-editable simulation request.
simulation : nuclear_simulation
  title = "One gram of uranium-238 through one solar-system age"
  sample.isotope = "U238"
  sample.mass = 1 g
  duration = 4.5 Gyr
  points = 1000
  time_grid = "logarithmic"
  minimum_time = 1 us
  output.csv = "inventory.csv"
  output.include_activity = true
  output.include_q_power = true
